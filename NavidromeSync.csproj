<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <!--MusicBee only loads plugin dlls whose file name starts with mb_-->
    <AssemblyName>mb_NavidromeSync</AssemblyName>
    <RootNamespace>MusicBeePlugin</RootNamespace>
    <!--version lives in Properties/AssemblyInfo.cs so the plugin can report it to MusicBee-->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
